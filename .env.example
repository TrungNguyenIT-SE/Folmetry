# Public canonical origin used by metadata, robots.txt, and sitemap.xml.
SITE_URL=http://localhost:3000

# M8A account system. Use a managed PostgreSQL connection in production.
# Generate BETTER_AUTH_SECRET with: pnpm exec auth secret
DATABASE_URL=postgresql://folmetry:folmetry@127.0.0.1:5432/folmetry
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google sign-in. Create a Web OAuth client and register:
# http://localhost:3000/api/auth/callback/google
# https://your-production-domain/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The matching verified registration is bootstrapped as the first admin.
# Remove/change this only through a reviewed production configuration change.
ADMIN_EMAIL=kythuatphanmemtdtu@gmail.com
ADMIN_USERNAME=adminfolmetry

# Server-only SMTP settings. Revoke exposed app passwords before configuring.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kythuatphanmemtdtu@gmail.com
SMTP_PASSWORD=

# Hostnames/IPs allowed to access Next.js development assets, comma-separated.
# Use hostnames only (no protocol, port, or path), then restart `pnpm dev`.
# DEV_ALLOWED_ORIGINS=192.168.1.16,26.226.155.12

# M6S remains disabled until provider/privacy review has written approval.
STORY_FEATURE_ENABLED=false
STORY_PROVIDER_APPROVED=false
STORY_PROVIDER=instagapi
STORY_PROVIDER_API_KEY=

# Generate a 32-byte base64url secret. Prefer a versioned keyring for rotation:
# STORY_MEDIA_TOKEN_KEYS=v2:<base64url-32-bytes>,v1:<previous-base64url-32-bytes>
# STORY_MEDIA_TOKEN_ACTIVE_KEY=v2
STORY_MEDIA_TOKEN_SECRET=

# Exact comma-separated provider/CDN hostnames; wildcards are rejected.
STORY_MEDIA_HOSTS=
