{
  "name": "folmetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "auth:migrate": "auth migrate --config auth.cli.ts -y",
    "auth:info": "auth info --config auth.cli.ts",
    "fixtures:generate": "node scripts/generate-synthetic-fixtures.mjs",
    "audit": "pnpm audit --prod --audit-level high",
    "check:ui-budget": "node scripts/check-ui-budget.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:ui-budget"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.15.0",
    "better-auth": "1.6.33",
    "dexie": "4.4.6",
    "next": "16.3.5",
    "nodemailer": "9.1.1",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/nodemailer": "7.0.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.6.33",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
